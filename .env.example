# Copy to .env.local and fill in. Never commit .env.local.
# Alternative names Supabase and the Vercel ↔ Supabase integration use are also
# accepted (see server/env.ts), e.g. NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY.

# ── Supabase: app + importer ───────────────────────────────────────────────
# Project Settings → API. The anon/publishable key only reads the galaxy
# (row-level security); it's the only Supabase key Vercel needs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# ── Importer only (keep these local; don't add them to Vercel) ────────────────
# Service-role / secret key: writes the repositories table.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Postgres connection string (Connect → session pooler), used by
# `npm run db:push` to create the table. URL-encode special characters in the password.
SUPABASE_DB_URL=

# GitHub token for the search API (a fine-grained token with public read access is enough).
GITHUB_TOKEN=

# Anthropic API key for classifying repositories.
ANTHROPIC_API_KEY=
# Optional: Claude model for classification (default: claude-sonnet-5).
CLASSIFIER_MODEL=
